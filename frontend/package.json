{
  "name": "cacaocover-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix ../tools/mock-server install --no-audit --no-fund",
    "dev": "vite",
    "dev:mock": "node ../tools/mock-server/dev.mjs",
    "build": "tsc --noEmit && vite build && node ../tools/sync-frontend.mjs",
    "flash": "node ../tools/flash.mjs",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
